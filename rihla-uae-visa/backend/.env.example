# Copy to .env for local development, or set these in your host's dashboard for production.
# Every value has a safe development default; production refuses to start without the real ones.

NODE_ENV=production
PORT=8787
APP_URL=https://rihla.example.com          # the web app (payment and email links point here)
API_URL=https://api.rihla.example.com      # this API
CORS_ORIGINS=https://rihla.example.com

AUTH_SECRET=                               # 32+ random characters: openssl rand -base64 48
OPS_EMAILS=ops@rihla.example.com           # who can open the ops console (comma separated)

DATABASE_URL=postgres://user:pass@host:5432/rihla   # Neon (usage-billed, sleeps when idle): use the pooled URL
DB_POOL_MAX=5                              # 1-2 on Lambda, 5 on a server
MIGRATE_ON_BOOT=true                       # false when the deploy step runs `npm run migrate`

STORAGE_DRIVER=s3                          # Cloudflare R2 or AWS S3 (UAE region: me-central-1)
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=rihla-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

MAIL_DRIVER=ses                            # ses: pay per email (~$0.10 / 1,000) | resend
SES_REGION=me-central-1
SES_ACCESS_KEY_ID=                         # leave empty on Lambda (uses the function's role)
SES_SECRET_ACCESS_KEY=
RESEND_API_KEY=
MAIL_FROM=Rihla <visas@rihla.example.com>

PAYMENTS_DRIVER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                     # webhook endpoint: $API_URL/v1/webhooks/stripe

FILING_PROVIDER=manual                     # manual (ops team on partner portal) | partner_http (partner API)
PARTNER_API_URL=
PARTNER_API_KEY=

ANTHROPIC_API_KEY=                         # passport reading; leave empty to have people type details
EXTRACT_MODEL=claude-opus-5-5
EXTRACT_EFFORT=low
EXTRACT_FAST_MODEL=                        # optional cheaper first pass, e.g. claude-haiku-5-5 (kept only if check digits pass)
AI_MONTHLY_BUDGET_USD=50                   # reading pauses (people type details) once spent this month; 0 = no cap
AI_CALLS_PER_APPLICATION=6                 # model calls one application can trigger; 0 = no cap

GOV_FEE_TOURIST_30=                        # AED, from your partner's rate card
GOV_FEE_TOURIST_60=
SERVICE_FEE=99
VAT_RATE=0.05

RETENTION_DAYS=30
TICK_SECONDS=15                            # background work in-process; 0 on Lambda (the scheduler invokes it)
CRON_SECRET=                               # for other serverless hosts: POST /internal/tick with x-cron-secret
