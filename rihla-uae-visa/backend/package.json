{
  "name": "rihla-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rihla API: applications, documents, passport reading, payments and filing through a licensed partner.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --enable-source-maps dist/server/server.mjs",
    "build": "node scripts/bundle.mjs",
    "migrate": "node --enable-source-maps dist/server/migrate.mjs",
    "try-reading": "tsx src/try-reading.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.3",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
