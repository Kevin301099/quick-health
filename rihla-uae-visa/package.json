{
  "name": "rihla-uae-visa",
  "version": "0.1.0",
  "private": true,
  "description": "Rihla: file your UAE visa with an AI agent. Upload documents, watch the agent work in a browser, step in only when needed.",
  "scripts": {
    "dev": "next dev --webpack",
    "try": "node scripts/try-local.mjs",
    "build": "next build --webpack",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "design-lint": "impeccable detect artifact/wrapped.html",
    "build:artifact": "next build --webpack && node scripts/inline-artifact.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.50.0",
    "motion": "^12.43.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "impeccable": "^4.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
